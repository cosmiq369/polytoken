i_high": 0.98, "bootstrap_replicates": 2000, "bootstrap_seed": 20261024, "cluster_count": 50, "bootstrap_unit": "chat", "confidence": 0.95}, {"company": "swara", "tokenizer_spec": "unsloth/gemma-3-4b-it", "part": "user", "paired_items": 124, "native_tokens": 2597, "english_tokens": 2543, "native_to_english_ratio": 1.0212347620920172, "ci_low": 0.9972676041306197, "ci_high": 1.0459675281885699, "bootstrap_replicates": 2000, "bootstrap_seed": 20261024, "cluster_count": 50, "bootstrap_unit": "chat", "confidence": 0.95}], "source": "Zetaris SQL", "query": "WITH inputs AS (\n SELECT 'samudra' AS company, chat_id, turn, role AS part, lang FROM company_systems.samudra__chats\n UNION ALL\n SELECT 'swara', chat_id, turn, role, lang FROM company_systems.swara__chats\n UNION ALL\n SELECT company, '__system__', 0, 'system_prompt', language FROM company_systems.samudra__bot_config\n UNION ALL\n SELECT company, '__system__', 0, 'system_prompt', language FROM company_systems.swara__bot_config\n), reference_coverage AS (\n SELECT lang_variant, COUNT(*) AS reference_sentences\n FROM company_systems.reference__sentences GROUP BY lang_variant\n), price_coverage AS (\n SELECT COUNT(*) AS price_rows FROM polytoken_reference.prices\n)\nSELECT i.company, n.tokenizer_spec, i.part,\n COUNT(*) AS paired_items, SUM(n.tokens) AS native_tokens, SUM(e.tokens) AS english_tokens,\n CAST(SUM(n.tokens) AS DOUBLE) / SUM(e.tokens) AS native_to_english_ratio,\n r.reference_sentences AS native_reference_sentences,\n er.reference_sentences AS english_reference_sentences, p.price_rows\nFROM inputs i\nJOIN company_systems.measurements__latest_token_counts n\n ON n.company=i.company AND n.chat_id=i.chat_id AND n.turn=i.turn AND n.part=i.part AND n.lang_variant=i.lang\nJOIN company_systems.measurements__latest_token_counts e\n ON e.company=n.company AND e.chat_id=n.chat_id AND e.turn=n.turn AND e.part=n.part\n AND e.tokenizer_spec=n.tokenizer_spec AND e.run_id=n.run_id AND e.lang_variant='en'\nJOIN reference_coverage r ON r.lang_variant=i.lang\nJOIN reference_coverage er ON er.lang_variant='en'\nCROSS JOIN price_coverage p\nGROUP BY i.company, n.tokenizer_spec, i.part, r.reference_sentences, er.reference_sentences, p.price_rows\nORDER BY i.company, n.tokenizer_spec, i.part\n", "verification_queries": ["SELECT * FROM company_systems.samudra__bot_config;\nSELECT * FROM company_systems.samudra__chats ORDER BY chat_id, turn", "SELECT * FROM company_systems.measurements__latest_token_counts WHERE company='samudra'", "SELECT * FROM company_systems.swara__bot_config;\nSELECT * FROM company_systems.swara__chats ORDER BY chat_id, turn", "SELECT * FROM company_systems.measurements__latest_token_counts WHERE company='swara'", "SELECT lang_variant, COUNT(*) AS n FROM company_systems.reference__sentences GROUP BY lang_variant", "SELECT COUNT(*) AS n FROM polytoken_reference.prices"], "fetched_at": "2026-10-24T15:11:55.189285+00:00", "time_window": {"start": "2026-10-24T15:11:47.383407+00:00", "end": "2026-10-24T15:11:55.189298+00:00"}, "measurement_run_ids": ["d8500f58-43a6-4aa8-93dd-df5bb62d15f1"], "ok": true, "translation_review": "pending", "money_available": false, "ts": "2026-10-24T15:11:55.194660+00:00", "run_id": "897d8034-092f-4e96-b842-65b08b9539e6", "event": "verified_cluster_intervals"}
