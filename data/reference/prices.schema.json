{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["model", "provider", "tokenizer_spec", "input_per_mtok_usd", "output_per_mtok_usd", "source_url", "fetched_at", "verified"],
    "properties": {
      "model": {"type": "string", "minLength": 1},
      "provider": {"type": "string", "minLength": 1},
      "tokenizer_spec": {"type": "string", "minLength": 1},
      "input_per_mtok_usd": {"type": ["number", "null"], "minimum": 0},
      "output_per_mtok_usd": {"type": ["number", "null"], "minimum": 0},
      "source_url": {"type": "string", "format": "uri"},
      "fetched_at": {"type": "string", "format": "date-time"},
      "verified": {"type": "boolean"}
    }
  }
}
